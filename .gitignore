# media and large binaries stay out of git (referenced by checksum)
*.mp4
*.mov
*.mkv
*.wav
*.m4a
*.jpg
*.png
media/originals/
media/proxies/
catalog/backups/
__pycache__/
*.pyc
.restore_check.sqlite

# brand watermark assets are our own and belong in the repo
!brand/watermark/*.png
# local Clipper runtime data (uploads, renders) never goes in git
tools/clipper/jobs/
tools/clipper/uploads/
tools/clipper/facecx
tools/clipper/scenelabel
tools/clipper/hidden_videos.json
